-- SAFE PROMPT FUNCTIONS
local function isTrash(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return false end
    if prompt:GetAttribute("IsTrash") == true then return true end
    local parent = prompt.Parent
    return parent and parent:GetAttribute("IsTrash") == true
end

local function getPart(prompt)
    local parent = prompt and prompt.Parent
    if not parent then return nil end
    
    if parent:IsA("BasePart") then return parent end
    if parent:IsA("Model") then 
        return parent.PrimaryPart or parent:FindFirstChildWhichIsA("BasePart", true)
    end
    return parent:FindFirstChildWhichIsA("BasePart", true)
end

local function optimizePrompt(prompt)
    pcall(function()
        if isTrash(prompt) and InstantSweep then
            prompt.HoldDuration = 0
        end
    end)
end

local function setBroomEquipped(equipped)
    if not PropEquipEvent then return end
    pcall(function()
        PropEquipEvent:FireServer("Broom", equipped)
    end)
end

-- CONTINUOUS HOLD & RE-HOLD (WALANG RETRY LIMIT)
local function triggerPrompt(prompt)
    if not prompt or not prompt.Parent then return false end
    
    optimizePrompt(prompt)
    setBroomEquipped(true)
    
    -- Tuloy-tuloy na magho-hold hanggang mawala/ma-destroy ang prompt sa Workspace
    while prompt and prompt.Parent do
        if typeof(fireproximityprompt) == "function" then
            pcall(function()
                fireproximityprompt(prompt)
            end)
            task.wait(0.02)
        else
            pcall(function()
                prompt:InputHoldBegin()
            end)
            
            local holdTime = prompt.HoldDuration
            local startTime = os.clock()
            
            while (os.clock() - startTime) < holdTime do
                task.wait(0.02)
                -- Kapag nawala ang prompt object sa game workspace, matagumpay na na-clean
                if not prompt or not prompt.Parent then
                    break
                end
            end
            
            pcall(function()
                prompt:InputHoldEnd()
            end)
        end
        
        -- Auto re-hold delay kapag na-interrupt o buhay pa rin ang prompt
        task.wait(0.02)
    end
    
    setBroomEquipped(false)
    return true
end

-- AUTO CLEAN
local function getNearestTrashPrompt()
    local root = getRoot()
    if not root then return nil end
    
    local nearest = nil
    local nearestDist = CleanRadius
    
    for _, prompt in ipairs(ProximityPromptService:GetRegisteredPrompts()) do
        if isTrash(prompt) then
            optimizePrompt(prompt)
            local part = getPart(prompt)
            if part then
                local dist = (root.Position - part.Position).Magnitude
                if dist < nearestDist then
                    nearestDist = dist
                    nearest = prompt
                end
            end
        end
    end
    return nearest
end

local function setAutoClean(enabled)
    AutoClean = enabled == true
    CleanerGeneration += 1
    if not AutoClean then return end
    
    local gen = CleanerGeneration
    task.spawn(function()
        while AutoClean and gen == CleanerGeneration do
            cleanOnce()
            task.wait(0.02)
        end
    end)
end

-- AUTO TP
local function getTrashPart(trash)
    if not trash then return nil end
    if trash:IsA("BasePart") then return trash end
    if trash:IsA("Model") then
        return trash.PrimaryPart or trash:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

local function findNearestTrash()
    local root = getRoot()
    if not root then return nil end
    
    local closest = nil
    local closestDist = math.huge
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if TrashModels[obj.Name] then
            local part = getTrashPart(obj)
            if part then
                local dist = (root.Position - part.Position).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closest = obj
                end
            end
        end
    end
    return closest
end

local function teleportToTrash(trash)
    local part = getTrashPart(trash)
    if not part then return false end
    
    local targetPos = part.Position + Vector3.new(0, 3, 0)
    local prompt = nil
    
    while trash and trash.Parent do
        if tp then
            tp(CFrame.new(targetPos))
        else
            local root = getRoot()
            if root then
                root.CFrame = CFrame.new(targetPos)
            end
        end
        
        local checkStart = os.clock()
        while (os.clock() - checkStart) < 0.15 do
            prompt = trash:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then
                break
            end
            task.wait(0.02)
        end
        
        if prompt then
            break
        end
        
        task.wait(0.01)
    end
    
    if prompt then
        triggerPrompt(prompt)
    end
    
    LastTrash = trash
    return true
end

-- AUTO TP LOOP FOR TRASH
task.spawn(function()
    while true do
        if cfg.autoTP then
            local trash = findNearestTrash()
            if trash and trash ~= LastTrash then
                pcall(function() teleportToTrash(trash) end)
                task.wait(0.1)
            elseif not trash then
                LastTrash = nil
            end
        end
        task.wait(0.1)
    end
end)

