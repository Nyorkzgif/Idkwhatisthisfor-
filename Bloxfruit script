local IngredientStats = {}
local ingredientNames = {}
local ingredientBusy = {}

local autoBuyThreshold = 5

for ingredientName, data in pairs(IngredientsConfig) do
    if type(data) == "table" and data.Cost then
        table.insert(ingredientNames, ingredientName)
    end
end

table.sort(ingredientNames, function(a, b)
    return tostring(a):lower() < tostring(b):lower()
end)

local function getIngredientStock(ingredientName)
    local ingredients = LocalPlayer:FindFirstChild("Ingredients")

    if not ingredients then
        return 0
    end

    local stock = ingredients:FindFirstChild(ingredientName)

    if not stock then
        return 0
    end

    return tonumber(stock.Value) or 0
end

local function getIngredientMax(ingredientName)
    local config = IngredientsConfig[ingredientName]

    if not config then
        return 100
    end

    return tonumber(
        config.MaxStock
        or config.Max
        or config.Capacity
        or config.Limit
    ) or 100
end

local function getIngredientPercent(ingredientName)
    local stock = getIngredientStock(ingredientName)
    local maxStock = getIngredientMax(ingredientName)

    if maxStock <= 0 then
        return 0
    end

    return math.clamp(
        (stock / maxStock) * 100,
        0,
        100
    )
end

local function updateIngredientStockDisplay(ingredientName)
    local paragraph = IngredientStats[ingredientName]

    if not paragraph then
        return
    end

    local stock = getIngredientStock(ingredientName)
    local maxStock = getIngredientMax(ingredientName)
    local percent = getIngredientPercent(ingredientName)

    paragraph:SetDesc(
        string.format(
            "%d / %d (%d%%)",
            stock,
            maxStock,
            math.floor(percent + 0.5)
        )
    )
end

local function refreshIngredientStocks()
    for _, ingredientName in ipairs(ingredientNames) do
        updateIngredientStockDisplay(ingredientName)
    end
end

local function buyIngredient(ingredientName, quantity)
    if ingredientBusy[ingredientName] then
        return false
    end

    local config = IngredientsConfig[ingredientName]

    if not config or not config.Cost then
        return false
    end

    quantity = math.floor(
        tonumber(quantity) or 0
    )

    if quantity <= 0 then
        return false
    end

    local stock = getIngredientStock(ingredientName)
    local maxStock = getIngredientMax(ingredientName)

    quantity = math.min(
        quantity,
        math.max(0, maxStock - stock)
    )

    if quantity <= 0 then
        return false
    end

    ingredientBusy[ingredientName] = true

    local ok, result = pcall(function()
        return BuyIngredient:InvokeServer(
            ingredientName,
            quantity,
            "Cash"
        )
    end)

    task.wait(0.2)

    ingredientBusy[ingredientName] = nil

    updateIngredientStockDisplay(ingredientName)

    return ok and result ~= false
end

local function buyIngredientMax(ingredientName)
    local stock = getIngredientStock(ingredientName)
    local maxStock = getIngredientMax(ingredientName)

    local quantity = math.max(
        0,
        maxStock - stock
    )

    if quantity <= 0 then
        return false
    end

    return buyIngredient(
        ingredientName,
        quantity
    )
end

