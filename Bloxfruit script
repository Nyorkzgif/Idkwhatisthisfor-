-- AUTO ORDER / AUTO REJECT
task.spawn(function() while true do
    if cfg.autoOrder then
        local totalAssigned = 0
        local totalRejected = 0

        for attempt = 1, 15 do
            if not cfg.autoOrder then
                break
            end

            local plot = getPlot()

            if not plot then
                break
            end

            -- CHECK FOR NPC FIRST
            local ok, npc, tbls = pcall(function()
                return GetCounterInfo:InvokeServer()
            end)

            -- IF THERE IS NO NPC, TAKE A NEW ORDER
            if not ok or not npc or not tbls then
                local counter = plot:FindFirstChild("Counter")

                if counter then
                    local comp = counter:FindFirstChild("Comp", true)

                    if comp then
                        for _, desc in ipairs(comp:GetDescendants()) do
                            if desc:IsA("ProximityPrompt") and desc.Enabled then
                                local action = tostring(desc.ActionText)

                                if string.find(action, "Take Order")
                                    or string.find(action, "Take") then

                                    local pp = desc.Parent

                                    if pp and pp:IsA("BasePart") then
                                        local release = acquireTp()

                                        tp(pp.CFrame * CFrame.new(0, 3, 0))
                                        task.wait(0.01)

                                        pcall(function()
                                            fireproximityprompt(desc)
                                        end)

                                        release()

                                        -- TAKE ORDER ONLY ONCE
                                        break
                                    end
                                end
                            end
                        end
                    end
                end

                -- STOP THIS ASSIGN CYCLE.
                -- The outer loop will check again normally.
                break
            end

            local id = npc.NpcId or npc.TemplateName or ""
            local templateName = npc.TemplateName or ""

            if id == "" or templateName == "" then
                break
            end

            -- GET NPC RARITY
            local npcData = NPCConfig.Types[templateName]
            local npcRarity = npcData and npcData.Rarity or "Unknown"

            -- AUTO REJECT CHECK
            -- Auto Assign must be ON.
            -- Auto Reject must ALSO be ON.
            -- At least one rarity must be selected.
            if cfg.autoRejectNPC
                and next(cfg.rejectNPCList) ~= nil
                and cfg.rejectNPCList[npcRarity] then

                local rejectOk = pcall(function()
                    RejectNPC:FireServer(id)
                end)

                if rejectOk then
                    totalRejected = totalRejected + 1
                end

                task.wait(0.5)

                -- Never assign a rejected NPC.
                break
            end

            -- NORMAL AUTO ASSIGN
            trackNPC(id)

            local assigned = false

            for _, t in ipairs(tbls) do
                if t.Slot and t.Seat then
                    local success = pcall(function()
                        AssignNPC:FireServer({
                            Slot = t.Slot,
                            Seat = t.Seat,
                            NPCName = id,
                            NpcId = id
                        })
                    end)

                    if success then
                        assigned = true
                        totalAssigned = totalAssigned + 1
                        break
                    end
                end
            end

            if not assigned then
                break
            end

            task.wait(0.05)
        end
    end

    task.wait(0.5)
end end)

