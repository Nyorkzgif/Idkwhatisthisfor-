local function getConfig(category, key)
    if category == "Tables" then
        if TableConfig and TableConfig.Get then
            local ok, result = pcall(function()
                return TableConfig:Get(key)
            end)
            if ok and result then
                return result
            end
        end
        return TableConfig and TableConfig[key]

    elseif category == "Chairs" then
        if ChairConfig and ChairConfig.Get then
            local ok, result = pcall(function()
                return ChairConfig:Get(key)
            end)
            if ok and result then
                return result
            end
        end
        return ChairConfig and ChairConfig[key]

    elseif category == "Materials" then
        if MaterialConfig and MaterialConfig.Get then
            local ok, result = pcall(function()
                return MaterialConfig:Get(key)
            end)
            if ok and result then
                return result
            end
        end
        return MaterialConfig and MaterialConfig[key]

    elseif category == "Paints" then
        if PaintConfig and PaintConfig.Get then
            local ok, result = pcall(function()
                return PaintConfig:Get(key)
            end)
            if ok and result then
                return result
            end
        end
        return PaintConfig and PaintConfig[key]

    elseif category == "Tiles" then
        if TileConfig and TileConfig.Get then
            local ok, result = pcall(function()
                return TileConfig:Get(key)
            end)
            if ok and result then
                return result
            end
        end
        return TileConfig and TileConfig[key]

    elseif category == "Stoves" then
        if StoveConfig and StoveConfig.Get then
            local ok, result = pcall(function()
                return StoveConfig:Get(key)
            end)
            if ok and result then
                return result
            end
        end
        return StoveConfig and StoveConfig[key]
    end

    return nil
end

local function getDisplayName(item)
    if not item then
        return "Unknown"
    end

    local config = item.Config

    if type(config) == "table" then
        return tostring(
            config.DisplayName
            or config.Name
            or item.Key
        )
    end

    return tostring(item.Key)
end

local function getPrice(item)
    if not item then
        return 0
    end

    local config = item.Config

    if type(config) == "table" then
        local price = tonumber(
            config.Price
            or config.Cost
        )

        if price then
            return price
        end
    end

    return tonumber(
        item.Price
        or item.Cost
    ) or 0
end

local function makeId(category, key)
    return tostring(category) .. ":" .. tostring(key)
end

local function getFurnitureConfig(systemType, category, key)
    if FurnitureConfig and FurnitureConfig.GetItemConfig then
        local ok, result = pcall(function()
            return FurnitureConfig:GetItemConfig(
                systemType,
                category,
                key
            )
        end)

        if ok and result then
            return result
        end
    end

    return getConfig(category, key)
end

local function addShopItems(shopData, category)
    local items = shopData and shopData[category]

    if type(items) ~= "table" then
        return
    end

    for _, item in ipairs(items) do
        if type(item) == "table" and item.Key ~= nil then
            local key = tostring(item.Key)
            local systemType = item.SystemType

            if category == "Tables"
            or category == "Chairs" then
                systemType = "Dining"
            elseif category == "Stoves" then
                systemType = "Kitchen"
            end

            local config = getFurnitureConfig(
                systemType,
                category,
                key
            )

            local id = makeId(category, key)

            ShopItems[id] = {
                Key = key,
                Category = category,
                SystemType = systemType,
                Stock = tonumber(item.Stock) or 0,
                Price = tonumber(
                    item.Price
                    or item.Cost
                ) or 0,
                Config = config
            }
        end
    end
end

local function refreshShop()
    local ok, shopData = pcall(function()
        return GetShopInfo:InvokeServer()
    end)

    if not ok or type(shopData) ~= "table" then
        return false
    end

    ShopItems = {}

    addShopItems(shopData, "Tables")
    addShopItems(shopData, "Chairs")
    addShopItems(shopData, "Materials")
    addShopItems(shopData, "Paints")
    addShopItems(shopData, "Tiles")
    addShopItems(shopData, "Stoves")

    return true
end

local function updateShopStock()
    local ok, shopData = pcall(function()
        return GetShopInfo:InvokeServer()
    end)

    if not ok or type(shopData) ~= "table" then
        return false
    end

    for _, category in ipairs({
        "Tables",
        "Chairs",
        "Materials",
        "Paints",
        "Tiles",
        "Stoves"
    }) do
        local items = shopData[category]

        if type(items) == "table" then
            for _, item in ipairs(items) do
                if type(item) == "table"
                and item.Key ~= nil then

                    local key = tostring(item.Key)
                    local id = makeId(category, key)
                    local stock = tonumber(item.Stock) or 0

                    if ShopItems[id] then
                        ShopItems[id].Stock = stock

                        local serverPrice = tonumber(
                            item.Price
                            or item.Cost
                        )

                        if serverPrice then
                            ShopItems[id].Price = serverPrice
                        end
                    end

                    local paragraph = ShopParagraphs[id]

                    if paragraph then
                        if stock > 0 then
                            paragraph:SetDesc(
                                "Stock: " .. tostring(stock)
                            )
                        else
                            paragraph:SetDesc(
                                "Stock: 0 | SOLD OUT"
                            )
                        end
                    end
                end
            end
        end
    end

    return true
end

local function showBuyNotification(displayName)
    pcall(function()
        WindUI:Notify({
            Title = "Shop",
            Content = "Bought " .. tostring(displayName),
            Duration = 1.2
        })
    end)
end

local function buyShopItem(item, manual)
    if not item then
        return false
    end

    local key = tostring(item.Key)
    local category = tostring(item.Category)
    local id = makeId(category, key)

    if ShopBusy[id] then
        return false
    end

    if (tonumber(item.Stock) or 0) <= 0 then
        return false
    end

    ShopBusy[id] = true

    local displayName = getDisplayName(item)
    local systemType = item.SystemType

    if category == "Tables"
    or category == "Chairs" then
        systemType = "Dining"
    elseif category == "Stoves" then
        systemType = "Kitchen"
    end

    local ok, result = pcall(function()
        return BuyFurniture:InvokeServer(
            systemType,
            category,
            key
        )
    end)

    ShopBusy[id] = nil

    if ok and result then
        if manual then
            showBuyNotification(displayName)
        end

        task.spawn(function()
            task.wait(0.15)
            refreshShop()
            updateShopStock()
        end)

        return true
    end

    task.spawn(function()
        updateShopStock()
    end)

    return false
end

local function getCategoryValues(category)
    local values = {}

    for _, item in pairs(ShopItems) do
        if item.Category == category then
            table.insert(
                values,
                getDisplayName(item)
            )
        end
    end

    table.sort(values)

    return values
end

local function findSelectedItem(category, name)
    name = tostring(name)

    for _, item in pairs(ShopItems) do
        if item.Category == category
        and getDisplayName(item) == name then
            return item
        end
    end

    return nil
end

local function processAutoBuy(category, enabled, selected)
    if not enabled then
        return
    end

    if type(selected) ~= "table"
    or #selected == 0 then
        return
    end

    for _, name in ipairs(selected) do
        local item = findSelectedItem(category, name)

        if item
        and (tonumber(item.Stock) or 0) > 0 then

            local id = makeId(
                item.Category,
                item.Key
            )

            local now = os.clock()
            local last =
                AutoBuyLastAttempt[id]
                or 0

            if now - last >= 1 then
                AutoBuyLastAttempt[id] = now

                task.spawn(function()
                    buyShopItem(item, false)
                end)
            end
        end
    end
end

