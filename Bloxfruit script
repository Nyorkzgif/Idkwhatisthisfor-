for _, categoryData in ipairs(categories) do
    ShopTab:Section({
        Title = categoryData.Name
    })

    local items = {}

    for id, item in pairs(ShopItems) do
        if item.Category == categoryData.Category then
            table.insert(items, {
                Id = id,
                Item = item
            })
        end
    end

    table.sort(items, function(a, b)
        return getDisplayName(a.Item)
            < getDisplayName(b.Item)
    end)

    for _, entry in ipairs(items) do
        local id = entry.Id
        local item = entry.Item

        local displayName =
            getDisplayName(item)

        local price =
            getPrice(item)

        local stock =
            tonumber(item.Stock)
            or 0

        local section = ShopTab:Section({
            Title = displayName
        })

        local info =
            "Price: $"
            .. tostring(price)

        if item.Config
        and item.Config.Description then
            info =
                info
                .. "\n"
                .. tostring(
                    item.Config.Description
                )
        end

        section:Paragraph({
            Title = displayName,
            Desc = info
        })

        local stockParagraph =
            section:Paragraph({
                Title = "Stock",
                Desc =
                    stock > 0
                    and "Stock: " .. tostring(stock)
                    or "Stock: 0 | OUT OF STOCK"
            })

        ShopParagraphs[id] =
            stockParagraph

        section:Button({
            Title = "Buy",
            Icon = "shopping-cart",
            Callback = function()
                buyShopItem(
                    item,
                    true
                )
            end
        })
    end
end

