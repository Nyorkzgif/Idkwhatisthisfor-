-- AUTO PAN
local returnToCounter = false
local chaseRunners = false

local PAN_NAMES = {
    pan = true,
    goldenpan = true,
    vippan = true
}

local function findPanTool()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character

    local containers = {
        backpack,
        char
    }

    for _, container in ipairs(containers) do
        if container then
            for _, tool in ipairs(container:GetChildren()) do
                if tool:IsA("Tool")
                    and PAN_NAMES[string.lower(tool.Name)] then
                    return tool
                end
            end
        end
    end

    return nil
end

task.spawn(function()
    while task.wait(0.5) do
        -- Toggle OFF
        if not cfg.autoPan then
            returnToCounter = false
            chaseRunners = false
            continue
        end

        local char, hum = getChar()
        if not char or not hum then
            continue
        end

        local clientNPCs = Workspace:FindFirstChild("ClientNPCs")
        local runawayNPC

        -- Detect runaway FIRST.
        if clientNPCs then
            for _, npc in ipairs(clientNPCs:GetChildren()) do
                if not cfg.autoPan then
                    break
                end

                if npc:IsA("Model")
                    and npc.Parent
                    and npc:GetAttribute("IsRunaway") == true
                    and isMyRunaway(npc) then

                    runawayNPC = npc
                    break
                end
            end
        end

        -- No runaway found.
        if not runawayNPC then
            -- Only return to counter if we actually chased a runner.
            if chaseRunners and not returnToCounter then
                returnToCounter = true
                chaseRunners = false

                local pan = findPanTool()

                pcall(function()
                    if pan and pan.Parent == char then
                        hum:UnequipTools()
                    end
                end)

                task.wait(0.15)

                -- Check toggle again after waiting.
                if not cfg.autoPan then
                    continue
                end

                local plot = getPlot()
                local counter = plot and plot:FindFirstChild("Counter")

                if counter then
                    local returnPart

                    if counter:IsA("BasePart") then
                        returnPart = counter
                    else
                        returnPart = counter:FindFirstChildWhichIsA(
                            "BasePart",
                            true
                        )
                    end

                    if returnPart and cfg.autoPan then
                        local release = acquireTp()

                        pcall(function()
                            if cfg.autoPan then
                                tp(returnPart.CFrame * CFrame.new(0, 3, 0))
                            end
                        end)

                        pcall(release)
                    end
                end
            end

            -- IMPORTANT:
            -- If enabled with no runner, nothing happens.
            continue
        end

        -- Runner detected.
        chaseRunners = true
        returnToCounter = false

        local root =
            runawayNPC:FindFirstChild("HumanoidRootPart")
            or runawayNPC.PrimaryPart

        if not root or not root.Parent then
            continue
        end

        -- Find pan only after detecting a runner.
        local pan = findPanTool()

        if not pan then
            continue
        end

        -- Equip only while chasing a runner.
        if pan.Parent ~= char then
            pcall(function()
                hum:EquipTool(pan)
            end)

            task.wait(0.2)
        end

        if not cfg.autoPan then
            continue
        end

        local release = acquireTp()

        pcall(function()
            if root.Parent and cfg.autoPan then
                tp(root.CFrame * CFrame.new(0, 0, -1.8))
            end

            task.wait(0.12)

            if cfg.autoPan
                and pan.Parent == char then

                pan:Activate()
            end
        end)

        pcall(release)

        task.wait(0.25)
    end
end)

-- AUTO WASH 
task.spawn(function()
    while true do
        if cfg.autoWash then
            local plot = getPlot()

            if plot then
                local sink = plot:FindFirstChild("Sink")
                local washed = 0

                -- Step 1: Collect dirty dishes
                local collectAreas = {}

                local dp = plot:FindFirstChild("DiningPlot1")
                if dp then
                    table.insert(collectAreas, dp)
                end

                local serve = plot:FindFirstChild("Serve")
                if serve then
                    table.insert(collectAreas, serve)
                end

                for _, area in ipairs(collectAreas) do
                    for _, desc in ipairs(area:GetDescendants()) do
                        if desc:IsA("ProximityPrompt") and desc.Enabled then
                            local action = desc.ActionText:lower()
                            local obj = desc.ObjectText:lower()

                            if string.find(obj, "dirty")
                                or string.find(obj, "dish")
                                or string.find(action, "wash")
                                or string.find(action, "pick") then

                                local pp = desc.Parent

                                if pp and pp:IsA("BasePart") then
                                    local release = acquireTp()

                                    tp(pp.CFrame * CFrame.new(0, 3, 0))
                                    task.wait(0.6)

                                    pcall(function()
                                        if desc.Enabled then
                                            fireproximityprompt(desc)
                                        end
                                    end)

                                    release()
                                    task.wait(0.3)

                                    -- Wait for dish/tool
                                    local gotTool = false

                                    for _ = 1, 20 do
                                        local c = LocalPlayer.Character

                                        if c and c:FindFirstChildOfClass("Tool") then
                                            gotTool = true
                                            break
                                        end

                                        task.wait(0.1)
                                    end

                                    if gotTool and sink then
                                        task.wait(0.15)

                                        -- Find Put prompt
                                        for _, pd in ipairs(sink:GetDescendants()) do
                                            if pd:IsA("ProximityPrompt") and pd.Enabled then
                                                local a = pd.ActionText:lower()

                                                if string.find(a, "put")
                                                    or string.find(a, "place")
                                                    or pd.Name == "Put" then

                                                    local r2 = acquireTp()

                                                    tp(
                                                        pd.Parent.CFrame
                                                        * CFrame.new(0, 3, 0)
                                                    )

                                                    task.wait(0.2)

                                                    pcall(function()
                                                        if pd.Enabled then
                                                            fireproximityprompt(pd)
                                                        end
                                                    end)

                                                    r2()

                                                    task.wait(0.5)
                                                    break
                                                end
                                            end
                                        end
                                    end

                                    -- Drop held dish/tool if necessary
                                    pcall(function()
                                        local c = LocalPlayer.Character

                                        if c then
                                            local t = c:FindFirstChildOfClass("Tool")

                                            if t then
                                                t.Parent = LocalPlayer.Backpack
                                            end
                                        end
                                    end)
                                end
                            end
                        end
                    end
                end

                -- Step 2: Wash dishes
                if sink then
                    for attempt = 1, 20 do
                        local washPrompt = nil

                        -- Find the actual ProximityPrompt directly.
                        -- Camera visibility is NOT required.
                        for _, pd in ipairs(sink:GetDescendants()) do
                            if pd:IsA("ProximityPrompt") and pd.Enabled then
                                local a = pd.ActionText:lower()
                                local o = pd.ObjectText:lower()

                                if string.find(a, "wash")
                                    or string.find(a, "clean")
                                    or string.find(a, "scrub")
                                    or string.find(o, "dish")
                                    or string.find(o, "dirty")
                                    or string.find(o, "plate") then

                                    washPrompt = pd
                                    break
                                end
                            end
                        end

                        if not washPrompt then
                            break
                        end

                        local promptParent = washPrompt.Parent

                        if not promptParent or not promptParent:IsA("BasePart") then
                            break
                        end

                        local release3 = acquireTp()

                        tp(
                            promptParent.CFrame
                            * CFrame.new(0, 3, 0)
                        )

                        task.wait(0.6)

                        -- Start the hold without checking camera visibility.
                        local holdStart = os.clock()
                        local holdActive = false

                        while washPrompt
                            and washPrompt.Parent
                            and washPrompt.Enabled
                            and os.clock() - holdStart < 6 do

                            if not holdActive then
                                local ok = pcall(function()
                                    washPrompt:InputHoldBegin()
                                end)

                                if ok then
                                    holdActive = true
                                end
                            end

                            task.wait(0.1)

                            -- Re-issue InputHoldBegin if the hold gets interrupted.
                            if holdActive
                                and washPrompt.Parent
                                and washPrompt.Enabled then

                                pcall(function()
                                    washPrompt:InputHoldBegin()
                                end)
                            else
                                holdActive = false
                            end
                        end

                        -- Always end the hold.
                        pcall(function()
                            if washPrompt and washPrompt.Parent then
                                washPrompt:InputHoldEnd()
                            end
                        end)

                        holdActive = false

                        release3()

                        washed = washed + 1

                        task.wait(0.5)
                    end
                end

            end
        end

        task.wait(cfg.washDelay)
    end
end)

